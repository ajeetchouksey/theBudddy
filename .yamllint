extends: default

ignore: |
  node_modules/
  build/

rules:
  indentation:
    spaces: 2
    indent-sequences: consistent
  line-length:
    max: 200
    level: warning
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
