{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajeetchouksey/theBudddy/knowledge/_schema/letter.json",
  "title": "Letter type",
  "description": "One YAML file per letter type in knowledge/<layer>/letters/. Deadlines are rules, never fixed dates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "layer", "scope", "name", "senders", "meaning", "deadline_rule",
    "next_step", "if_missed", "referral", "scam_signs", "source_url", "last_verified", "reviewer"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "description": "<scope>.letters.<slug>",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\.letters\\.[a-z0-9][a-z0-9_-]*$"
    },
    "layer": { "enum": ["national", "state", "city", "university"] },
    "scope": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "phase": { "type": "integer", "minimum": 0, "maximum": 7 },
    "name": {
      "description": "Plain-English name, German term in brackets the first time",
      "type": "string", "minLength": 1, "maxLength": 120
    },
    "senders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "domains"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "domains": {
            "description": "Official email sender domains, used for Gmail search by sender",
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
            "uniqueItems": true
          }
        }
      }
    },
    "meaning": { "type": "string", "minLength": 1, "maxLength": 800 },
    "deadline_rule": {
      "description": "A rule such as 'within 14 days of the letter date', never a fixed date",
      "type": "string", "minLength": 1, "maxLength": 300
    },
    "next_step": { "type": "string", "minLength": 1, "maxLength": 600 },
    "if_missed": { "type": "string", "minLength": 1, "maxLength": 400 },
    "referral": { "type": "string", "minLength": 1, "maxLength": 300 },
    "scam_signs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "source_url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 500 },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reviewer": { "type": "string", "pattern": "^$|^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" },
    "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
