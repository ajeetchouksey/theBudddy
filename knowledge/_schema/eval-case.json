{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajeetchouksey/theBudddy/knowledge/_schema/eval-case.json",
  "title": "Eval case file",
  "description": "One YAML file per eval set in evals/cases/ (docs/ai-guardrails.md, Evaluation and red-team set). Invented data only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "set", "cases"],
  "properties": {
    "schema": { "const": 1 },
    "set": { "$ref": "#/$defs/set" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "set": {
      "enum": [
        "factual", "unknowns", "numbers_from_sheets", "prompt_injection", "privacy",
        "sensitive_topics", "ask_first", "capability_honesty", "tone_inclusion"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "set", "input", "must"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+-[0-9]{3}$" },
        "set": { "$ref": "#/$defs/set" },
        "rules": {
          "description": "Guardrail rule IDs or section references",
          "type": "array",
          "items": { "type": "string", "pattern": "^(G-[AQN][0-9]+|section [0-9]+)$" },
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(N?FR-[A-Z0-9]+\\.[0-9]+)$" },
          "uniqueItems": true
        },
        "pack_ids": {
          "description": "Entries a factual answer must use",
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "context": {
          "description": "Invented profile, sheet values or capability flags the case assumes",
          "type": "object"
        },
        "tools": {
          "type": "array",
          "items": { "enum": ["gemini", "claude", "copilot"] },
          "uniqueItems": true
        },
        "zero_tolerance": { "type": "boolean" },
        "input": { "type": "string", "minLength": 1 },
        "must": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "must_not": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
