{
  "name": "germany-student-companion",
  "private": true,
  "version": "0.0.0",
  "description": "JS tooling for the Germany Student Companion (Apps Script tests, formatting)",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write \"apps-script/**/*.{js,html}\" \"spike/**/*.js\" \"skill/reference/*.html\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"apps-script/**/*.{js,html}\" \"spike/**/*.js\" \"skill/reference/*.html\""
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "vitest": "5.0.4"
  }
}
