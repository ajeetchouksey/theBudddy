{
  "name": "germany-student-companion",
  "private": true,
  "version": "0.0.0",
  "description": "JS tooling for the Germany Student Companion (Apps Script tests, formatting)",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write \"apps-script/**/*.{js,html}\" \"skill/reference/*.html\"",
    "format:check": "prettier --check \"apps-script/**/*.{js,html}\" \"skill/reference/*.html\""
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "vitest": "2.1.1"
  }
}
